{
  "name": "cuentas-claras-api",
  "version": "1.5.1",
  "description": "REST API for Cuentas Claras shared expenses app.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@10.26.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@swc/core",
      "argon2",
      "prisma"
    ],
    "overrides": {
      "find-my-way": "^9.7.0",
      "valibot": "^1.4.2",
      "minimatch@3.1.5>brace-expansion": "5.0.9",
      "minimatch@9.0.9>brace-expansion": "5.0.9",
      "minimatch@5.1.9>brace-expansion": "5.0.9",
      "minimatch@10.2.5>brace-expansion": "5.0.9",
      "brace-expansion": "5.0.9",
      "js-yaml": "5.2.3",
      "@prisma/config>deepmerge-ts": "8.0.1"
    }
  },
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "build": "nest build",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "security:audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/pnpm-audit-validator.ts",
    "workflow:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/validate-openspec.ts",
    "verify": "pnpm test && pnpm run test:e2e && pnpm run security:audit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.9.1",
    "joi": "^18.2.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.29",
    "@swc/core": "^1.15.47",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  }
}
